# Video Parser 环境配置

# ==================== Qwen3-VL API 配置 ====================
# API 基础地址（ModelScope）
QWEN_API_BASE_URL=https://api-inference.modelscope.cn/v1

# API 密钥（从 ModelScope 获取）
# 获取地址：https://modelscope.cn/my/myaccesstoken
QWEN_API_KEY=your-modelscope-api-key-here

# 模型 ID
QWEN_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct

# ==================== 证据优先视频分析 ====================
# 单个视频最多保留的带时间戳画面数；会混合连续、场景变化和字幕变化采样
MAX_ANALYSIS_FRAMES=12

# 连续采样基础间隔（秒）
FRAME_INTERVAL_SECONDS=2.0

# 场景变化阈值（越低越敏感，建议 0.25-0.40）
SCENE_CHANGE_THRESHOLD=0.32

# 场景/文字变化检测频率，降低该值可减少长视频预处理开销
CHANGE_DETECTION_FPS=2.0

# 画面下部字幕/界面文字区域变化候选阈值（越低越敏感）
TEXT_REGION_CHANGE_THRESHOLD=0.10

# 每次送入视觉模型的帧数，分批观察后再汇总
VISION_BATCH_SIZE=3
VISION_BATCH_RETRIES=2
# 限制本地模型单阶段最大输出，避免飞书任务长时间无界生成
VISION_MAX_TOKENS=900
SYNTHESIS_MAX_TOKENS=2800
TITLE_CHECK_MAX_TOKENS=500
# 视觉与文本推理可分离：视觉模型读帧，文本模型负责证据重建和质检
# SYNTHESIS_MODEL_ID=qwen2.5:7b
# QUALITY_MODEL_ID=qwen2.5:7b
ENABLE_ANALYSIS_QC=1
QUALITY_REWRITE_MAX_TOKENS=2800
# 缓存同一视频/模型的 ASR 与视觉阶段，重试时无需重复昂贵计算
AI_STAGE_CACHE=1
# 飞书中单独发送的 ASR 清洗稿
# ASR_CLEAN_MODEL_ID=qwen2.5:7b
ASR_CLEAN_MAX_TOKENS=7000
ASR_CLEAN_BATCH_LINES=5
ASR_CLEAN_BATCH_MAX_TOKENS=1800
AUDIENCE_REPORT_MAX_TOKENS=3000
SEGMENT_SUMMARY_MAX_TOKENS=700

# 可选：OpenAI 兼容 ASR。未配置时会明确降级为“仅字幕/视觉分析”，不会伪造口播。
# ASR_API_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=your-asr-api-key
# ASR_MODEL_ID=whisper-1
# ASR_LANGUAGE=zh
# ASR_CHUNK_SECONDS=0
# 本地方案：ASR_BACKEND=faster-whisper，ASR_MODEL_ID=large-v3
# ASR_DEVICE=auto
# ASR_COMPUTE_TYPE=auto
# ASR_CPU_THREADS=8
# ASR_NUM_WORKERS=1
# ASR_CACHE_DIR=cache/asr

# 抖音链接直达文字稿：本机详情接口遇到 403 时，可使用 TikHub 作品详情 API。
# 在 https://user.tikhub.io/dashboard/api 创建密钥后填入；密钥只留在本机。
# TIKHUB_API_KEY=你的TikHub API Key
# FEISHU_VIDEO_MODE=transcript
# ASR_BACKEND=faster-whisper
# ASR_MODEL_ID=large-v3
# ASR_DEVICE=cuda
# ASR_COMPUTE_TYPE=float16
# ASR_BEAM_SIZE=5
# ASR_BATCH_SIZE=4
# ASR_GPU_MIN_FREE_MB=5500
# ASR_ALLOW_CPU_FALLBACK=0
# ASR_CONDITION_ON_PREVIOUS_TEXT=1

# 可选的云端转写方案（当前本机 GPU 方案无需以下腾讯云密钥）
# FEISHU_VIDEO_MODE=transcript
# FEISHU_TASK_TIMEOUT_SECONDS=180
# ASR_BACKEND=tencent-flash
# ASR_MODEL_ID=tencent-flash
# ASR_CHUNK_SECONDS=0
# ASR_MAX_DURATION_SECONDS=0
# ASR_REQUEST_TIMEOUT_SECONDS=120
# TENCENT_ASR_APP_ID=你的腾讯云AppID
# TENCENT_ASR_SECRET_ID=你的腾讯云SecretID
# TENCENT_ASR_SECRET_KEY=你的腾讯云SecretKey
# TENCENT_ASR_ENGINE=16k_zh

# ==================== 服务配置 ====================
# 后端 API 服务地址（Gradio 前端调用）
# 在单端口模式下，默认为 http://127.0.0.1:7860
API_SERVER_URL=http://127.0.0.1:7860

# 服务域名（用于生成下载链接，可选）
# 如果不配置，系统将根据请求头自动识别域名
# DOMAIN=https://your-domain.com

# ==================== 飞书机器人配置 ====================
# 在飞书开放平台 (https://open.feishu.cn/) 创建自建应用后获取
FEISHU_APP_ID=cli_xxxxxx
FEISHU_APP_SECRET=xxxxxx
# 机器人 Open ID（用于群聊中识别 @机器人）
FEISHU_BOT_OPEN_ID=ou_xxxxxx
# 并发分析任务上限
FEISHU_MAX_CONCURRENT=1
# 单个飞书分析任务总超时；超时后卡片自动显示失败，迟到结果不会覆盖
FEISHU_TASK_TIMEOUT_SECONDS=1800
# 飞书消息 API 与模型单次请求超时
FEISHU_API_TIMEOUT_SECONDS=15
MODEL_TIMEOUT_SECONDS=300

# 可选：绑定已有飞书多维表格。留空时首次归档会自动创建“视频爆款分析库”。
# FEISHU_BITABLE_APP_TOKEN=appxxxxxxxxxxxxxxxxx
# FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxxxxxxx
# FEISHU_BITABLE_BASE_URL=https://your-tenant.feishu.cn/base/appxxxxxxxxxxxxxxxxx
# 飞书应用需开通：创建多维表格(base:app:create 或 bitable:app)，以及读写多维表格记录/字段权限。
