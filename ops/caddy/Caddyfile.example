{
	default_sni 110.40.138.167
}

http://110.40.138.167 {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

https://110.40.138.167 {
	encode zstd gzip
	tls /etc/caddy/certs/video-parser-fullchain.pem /etc/caddy/certs/video-parser-key.pem
	handle /admin {
		redir /admin/ 308
	}
	handle_path /admin/* {
		reverse_proxy 127.0.0.1:7861 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Prefix /admin
		}
	}
	handle {
		reverse_proxy 127.0.0.1:7860 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
